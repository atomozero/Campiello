/*
 * Resources for the Campiello SFTP connect helper (campiello_mount).
 * The app_signature is registered by mimeset at build time so be_roster can find and launch it by
 * signature (the Vicinato opens it on a double-click). Must match kSignature in campiello_mount.cpp.
 */

resource app_signature "application/x-vnd.Campiello-mount";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (SFTP)",
	long_info = "Campiello connect helper: mount a remote SFTP host as a disk"
};
