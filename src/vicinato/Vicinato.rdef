/*
 * Resources for the Campiello WON app (World O' Networking, the network-neighborhood browser;
 * internal codename "vicinato"). The app_signature is registered by mimeset at build time so
 * be_roster can find and launch it by signature, and so it can in turn launch the SMB/SFTP connect
 * helpers by their signatures. Must match kSignature in campiello_vicinato.cpp.
 */

resource app_signature "application/x-vnd.Campiello-won";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "WON",
	long_info = "WON - World O' Networking: browse the services on your LAN"
};
