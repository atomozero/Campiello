/*
 * Resources for the Campiello Deskbar replicant.
 * The add-on needs its own MIME signature: when the BShelf archives the freshly-added view it
 * records an "add_on" field, and the Deskbar uses that signature to reload the add-on after a
 * reboot. Must match kReplicantSignature in PeerReplicant.cpp.
 */

resource app_signature "application/x-vnd.Campiello-replicant";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello Deskbar",
	long_info = "Campiello LAN peer presence for the Haiku Deskbar"
};
