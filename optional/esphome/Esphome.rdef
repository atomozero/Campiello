/*
 * Resources for the Campiello ESPHome add-on (campiello_esphome).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of an ESPHome device). Must match kSignature in
 * campiello_esphome.cpp.
 */

resource app_signature "application/x-vnd.Campiello-esphome";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (ESPHome)",
	long_info = "Campiello device add-on: show an ESPHome node's info and open its web UI"
};
