/*
 * Resources for the Campiello NFS add-on (campiello_nfs).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of an NFS server). Must match kSignature in campiello_nfs.cpp.
 */

resource app_signature "application/x-vnd.Campiello-nfs";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (NFS)",
	long_info = "Campiello device add-on: list an NFS server's exports and how to mount them"
};
