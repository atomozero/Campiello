# Campiello device handler manifest for the NFS add-on (docs/DEVICE_ADDONS.md).
# Installed into the handlers directory; the WON app matches it to a discovered NFS server and
# launches the add-on with the device (host=<ip> name=<label>). It lists exports and shows how to
# mount them; it does not mount anything (KDL hazard). A native NFS client is a follow-up.
signature  = application/x-vnd.Campiello-nfs
name       = Server NFS
match.type = _nfs._tcp
action.open = Condivisioni
