/*
 * Resources for the Campiello NUT add-on (campiello_nut).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a UPS device). Must match kSignature in
 * campiello_nut.cpp.
 */

resource app_signature "application/x-vnd.Campiello-nut";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (UPS)",
	long_info = "Campiello device add-on: monitor a UPS via a Network UPS Tools server"
};
