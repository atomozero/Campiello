/*
 * Resources for the Campiello Daikin add-on (campiello_daikin).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Daikin device). Must match kSignature in
 * campiello_daikin.cpp.
 */

resource app_signature "application/x-vnd.Campiello-daikin";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Daikin)",
	long_info = "Campiello device add-on: control a Daikin air conditioner over its local HTTP API"
};
