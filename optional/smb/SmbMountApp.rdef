/*
 * Resources for the Campiello SMB connect helper (campiello_smb_mount).
 * The app_signature is registered by mimeset at build time so be_roster can find and launch it by
 * signature (the Vicinato opens it on a double-click of a Windows share). Must match kSignature in
 * campiello_smb_mount.cpp.
 */

resource app_signature "application/x-vnd.Campiello-smb-mount";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (SMB)",
	long_info = "Campiello connect helper: mount a Windows shared folder as a disk"
};
