# Campiello device handler manifest for the HomeKit add-on (docs/DEVICE_ADDONS.md).
# Installed into the handlers directory; the WON app matches it to a discovered HomeKit accessory and
# launches the add-on with the device (CAMPIELLO:host/name + the mDNS TXT as CAMPIELLO:txt.<key>).
# It shows the accessory's public info; full control needs HomeKit pairing (crypto), a follow-up.
signature  = application/x-vnd.Campiello-homekit
name       = Accessorio HomeKit
match.type = _hap._tcp
action.open = Informazioni
