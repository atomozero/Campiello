/*
 * Resources for the Campiello HomeKit add-on (campiello_homekit).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a HomeKit accessory). Must match kSignature in
 * campiello_homekit.cpp.
 */

resource app_signature "application/x-vnd.Campiello-homekit";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (HomeKit)",
	long_info = "Campiello device add-on: show an Apple HomeKit accessory's advertised info"
};
