/*
 * Resources for the Campiello DAAP music-library add-on (campiello_daap).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a music library). Must match kSignature in
 * campiello_daap.cpp.
 */

resource app_signature "application/x-vnd.Campiello-daap";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Libreria DAAP)",
	long_info = "Campiello device add-on: browse a shared iTunes/DAAP music library"
};
