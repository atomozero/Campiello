/*
 * Resources for the Campiello Google Cast add-on (campiello_cast).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Cast device). Must match kSignature in campiello_cast.cpp.
 */

resource app_signature "application/x-vnd.Campiello-cast";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Google Cast)",
	long_info = "Campiello device add-on: launch and stop apps on a Google Cast device (DIAL)"
};
