# Campiello device handler manifest for the AirPlay add-on (docs/DEVICE_ADDONS.md).
# Installed into the handlers directory; the WON app matches it to a discovered AirPlay receiver and
# launches the add-on with the device (CAMPIELLO:host/name + the mDNS TXT as CAMPIELLO:txt.<key>).
# It shows the receiver's info; streaming/mirroring needs the AirPlay 2 handshake + FairPlay, a follow-up.
signature  = application/x-vnd.Campiello-airplay
name       = Ricevitore AirPlay
match.type = _airplay._tcp
match.type = _raop._tcp
action.open = Informazioni
