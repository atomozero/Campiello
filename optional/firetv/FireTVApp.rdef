/*
 * Resources for the Campiello Fire TV remote (campiello_firetv).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Fire TV device). Must match kSignature in
 * campiello_firetv.cpp.
 */

resource app_signature "application/x-vnd.Campiello-firetv";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Fire TV)",
	long_info = "Campiello device add-on: an on-screen remote for an Amazon Fire TV"
};
