/*
 * Resources for the Campiello Philips Hue add-on (campiello_hue).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Hue bridge). Must match kSignature in campiello_hue.cpp.
 */

resource app_signature "application/x-vnd.Campiello-hue";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Philips Hue)",
	long_info = "Campiello device add-on: a control panel for a Philips Hue bridge"
};
