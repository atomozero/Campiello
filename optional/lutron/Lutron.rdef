/*
 * Resources for the Campiello Lutron add-on (campiello_lutron).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Lutron bridge). Must match kSignature in
 * campiello_lutron.cpp.
 */

resource app_signature "application/x-vnd.Campiello-lutron";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Lutron)",
	long_info = "Campiello device add-on: show a Lutron smart bridge's presence and LEAP info"
};
