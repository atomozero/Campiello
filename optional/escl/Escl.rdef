/*
 * Resources for the Campiello eSCL scanning add-on (campiello_escl).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a scanner). Must match kSignature in campiello_escl.cpp.
 */

resource app_signature "application/x-vnd.Campiello-escl";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Scanner eSCL)",
	long_info = "Campiello device add-on: an eSCL/AirScan network-scanner panel"
};
