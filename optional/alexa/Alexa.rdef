/*
 * Resources for the Campiello Alexa add-on (campiello_alexa).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of an Alexa device). Must match kSignature in
 * campiello_alexa.cpp.
 */

resource app_signature "application/x-vnd.Campiello-alexa";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Alexa)",
	long_info = "Campiello device add-on: show an Amazon Alexa device's presence"
};
