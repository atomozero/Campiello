# Campiello device handler manifest for the Spotify Connect add-on (docs/DEVICE_ADDONS.md).
# Installed into the handlers directory; the WON app matches it to a discovered Spotify Connect
# receiver and launches the add-on with the device (CAMPIELLO:host/name, CAMPIELLO:port, and the mDNS
# TXT as CAMPIELLO:txt.<key>). It shows the speaker's public info; playback control needs account
# auth, a follow-up.
signature  = application/x-vnd.Campiello-spotify
name       = Spotify Connect
match.type = _spotify-connect._tcp
action.open = Informazioni
