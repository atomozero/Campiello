/*
 * Resources for the Campiello Spotify Connect add-on (campiello_spotify).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a Spotify Connect device). Must match kSignature in
 * campiello_spotify.cpp.
 */

resource app_signature "application/x-vnd.Campiello-spotify";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Spotify)",
	long_info = "Campiello device add-on: show a Spotify Connect speaker's info"
};
