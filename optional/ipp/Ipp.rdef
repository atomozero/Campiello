/*
 * Resources for the Campiello IPP printing add-on (campiello_ipp).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a printer). Must match kSignature in campiello_ipp.cpp.
 */

resource app_signature "application/x-vnd.Campiello-ipp";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Stampante IPP)",
	long_info = "Campiello device add-on: an IPP network-printer panel"
};
