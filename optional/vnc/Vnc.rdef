/*
 * Resources for the Campiello VNC remote-desktop add-on (campiello_vnc).
 * The app_signature is registered by mimeset at build time so be_roster can launch it by signature
 * (the WON app opens it on a double-click of a remote desktop). Must match kSignature in
 * campiello_vnc.cpp.
 */

resource app_signature "application/x-vnd.Campiello-vnc";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Campiello (Desktop remoto VNC)",
	long_info = "Campiello device add-on: open a VNC remote desktop in an installed viewer"
};
