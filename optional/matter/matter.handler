# Campiello device handler manifest for the Matter add-on (docs/DEVICE_ADDONS.md).
# Installed into the handlers directory; the WON app matches it to a discovered Matter device and
# launches the add-on with the device (CAMPIELLO:host/name + the mDNS TXT as CAMPIELLO:txt.<key>).
# It shows the device's public info; commissioning/control needs the Matter SDK (crypto), a follow-up.
signature  = application/x-vnd.Campiello-matter
name       = Dispositivo Matter
match.type = _matter._tcp
match.type = _matterc._udp
action.open = Informazioni
