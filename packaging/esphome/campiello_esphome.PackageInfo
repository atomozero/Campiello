name			campiello_esphome
version			0.1.0-1
architecture	x86_64
summary			"ESPHome device info for Campiello"
description		"Optional device add-on for Campiello: for an ESPHome node on the network
(_esphomelib._tcp) it shows what the device advertises over mDNS (ESPHome/firmware version, project,
board, platform, MAC) and opens its web interface. Full entity/sensor control uses the ESPHome native
protobuf API (port 6053), documented as a follow-up and not faked here. No network, no third-party
dependency; part of the MIT-clean add-on suite. Launched from the WON network neighborhood on a
double-click of a discovered ESPHome device."
packager		"atomozero <atomozero@proton.me>"
vendor			"atomozero"

copyrights {
	"2026 atomozero"
}

licenses {
	"MIT"
}

provides {
	campiello_esphome = 0.1.0
}

requires {
	haiku >= r1~beta5
}
